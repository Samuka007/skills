[5.966, "o", "kept 2 sessions -> /tmp/asbe-demo/curated-demo/keep\r\nmanifest: /tmp/asbe-demo/curated-demo/manifest.json\u001b[25;1Hverify every copy is byte-identical:\r\n  jq -r '.[] | \"\\(.source)\\t\\(.kept_as)\"' /tmp/asbe-demo/curated-demo/manifest.json > /tmp/pairs.tsv\r\n  while IFS=$'\\t' read -r s d; do d=\"${d%$'\\r'}\"; cmp -s \"$s\" \"$d\" || echo \"MISMATCH $s\"; done < /tmp/pairs.tsv\r\n"]
[5.973, "o", "\r\nverified: 2/2 copies byte-identical to their originals\r\ncorpus:  /tmp/asbe-demo/curated-demo/keep\r\nmanifest: /tmp/asbe-demo/curated-demo/manifest.json\r\n"]
