[5.841, "o", "\u001b[?25l\u001b[H\u001b[K\u001b[36m\u001b[1m\r\nskills\u001b(B\u001b[m on \u001b[35m\u001b[1m master\u001b(B\u001b[m \u001b[31m\u001b[1m[?]\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m cd /home/nixos/workspace/skills\u001b[K\r\nbash skills/agent-session-batch-export/scripts/pick-sessions.sh -o /tmp/asbe-demo/curated-demo -y --review-only\u001b[K\r\n\u001b[K\u001b[36m\u001b[1m\r\nskills\u001b(B\u001b[m on \u001b[35m\u001b[1m master\u001b(B\u001b[m \u001b[31m\u001b[1m[?]\u001b(B\u001b[m \u001b[32m\u001b[1m❯\u001b(B\u001b[m bash skills/agent-session-batch-export/scripts/pick-sessions.sh -o /tmp/asbe-demo/curated-demo -y --review-only\u001b[K\r\noutput directory: /tmp/asbe-demo/curated-demo\u001b[K\r\n\u001b[K\r\n== pick ================================================================\u001b[K\r\n   2 rows are PRE-SELECTED at the top — the screening's picks.\u001b[K\r\n   TAB any of them to drop it, or TAB a lower row to add it.\u001b[K\r\n   (2 rejected rows follow below, unselected.)\u001b[K\r\n   TAB    mark / unmark the highlighted row (stays put)\u001b[K\r\n   ENTER  confirm  (marked rows are kept)        ESC  abort\u001b[K\r\n   ctrl-a all   ctrl-d none      ctrl-o hide/show preview\u001b[K\r\n   shift-↑/↓ scroll preview   PgUp/PgDn by page   alt-↑/↓ top/bottom\u001b[K\r\n   (the preview cannot take focus — fzf has no such concept — so it is\u001b[K\r\n    scrolled by keys, never by tabbing into it)\u001b[K\r\n========================================================================\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[?12l\u001b[?25h\u001b[19A\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l"]
